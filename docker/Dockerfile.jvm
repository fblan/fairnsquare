####
# Multi-stage image: Maven builds the vidocq distribution (fairnsquare-app/target/fairnsquare-app-*/: bin, lib, app),
# then a JRE image runs it. Build context is the repo root:
#
#   docker build -f docker/Dockerfile.jvm -t fairnsquare .
#
# Tests are skipped here; run them before pushing.
####

# The commit, for /api/info and the startup log (app.git.commit, from APP_GIT_COMMIT).
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest AS gitinfo
ARG GIT_COMMIT=unknown
RUN microdnf install -y git && microdnf clean all
COPY pom.xml .gi[t] /gitmeta/
RUN if [ "$GIT_COMMIT" != "unknown" ]; then echo "$GIT_COMMIT" > /git-commit; \
    else git --git-dir=/gitmeta rev-parse HEAD > /git-commit 2>/dev/null || echo unknown > /git-commit; fi

FROM registry.access.redhat.com/ubi9/openjdk-25:1.24-2.1771324969 AS builder
USER root
WORKDIR /build
# Poms first, so the dependency download layer is cached until either changes.
COPY pom.xml ./
COPY fairnsquare-app/pom.xml ./fairnsquare-app/
RUN mvn -B -q dependency:go-offline -pl fairnsquare-app
COPY fairnsquare-app/src ./fairnsquare-app/src
RUN mvn -B -q package -DskipTests -pl fairnsquare-app \
    && mkdir dist \
    && cp -r fairnsquare-app/target/fairnsquare-app-*/. dist/

FROM registry.access.redhat.com/ubi9/openjdk-25-runtime:latest
WORKDIR /deployments
USER root
# Fonts: the CAPTCHA image is drawn with AWT.
RUN microdnf install -y fontconfig dejavu-sans-fonts && microdnf clean all \
    && chown 1001:root /deployments \
    && chmod "g+rwX" /deployments \
    && mkdir -p /data \
    && chown 1001:root /data \
    && chmod "g+rwX" /data
COPY --from=builder --chown=1001:root /build/dist/ /deployments/
COPY --from=gitinfo --chown=1001:root /git-commit /deployments/git-commit

# vidocq.http.port (vidocq.properties)
EXPOSE 8080
USER 1001
VOLUME ["/data"]

ENV JAVA_OPTS="-Djava.awt.headless=true -Xmx512m -XX:-UseBASE64Intrinsics"
ENV FAIRNSQUARE_DATA_PATH="/data"
ENTRYPOINT ["sh", "-c", "export APP_GIT_COMMIT=\"${APP_GIT_COMMIT:-$(cat /deployments/git-commit)}\"; exec /deployments/bin/fairnsquare-app.sh"]
